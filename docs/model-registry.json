  "routing_policy": {
    "description": "Escalation ladder. Start at the cheapest tier that satisfies hard constraints, escalate on failure signal.",
    "hard_constraints": [
      { "name": "eu_residency", "filter": "regions includes EU" },
      { "name": "zero_data_retention", "filter": "caps includes zdr" },
      { "name": "open_weights_required", "filter": "weights == open" },
      { "name": "context_fits", "filter": "context >= estimated_prompt_tokens * 1.2" },
      { "name": "vision_required", "filter": "caps includes vision" }
    ],
    "task_routing": {
      "classify_extract_route": ["google/gemini-2.5-flash-lite", "inclusionai/ling-3.0-flash", "zai/glm-5.3-flash"],
      "summarise_bulk": ["deepseek/deepseek-v4.1-flash", "openai/gpt-5.6-luna"],
      "tool_call_simple": ["anthropic/claude-haiku-4.5", "google/gemini-3.5-flash-lite"],
      "agent_loop_default": ["anthropic/claude-sonnet-5", "zai/glm-5.3", "google/gemini-3.8-flash"],
      "agent_loop_hard": ["anthropic/claude-opus-5", "anthropic/claude-fable-5.1"],
      "coding_cheap": ["xai/grok-build-0.1", "zai/glm-5.3"],
      "coding_hard": ["anthropic/claude-fable-5.1", "anthropic/claude-opus-5"],
      "math_proof": ["openai/gpt-5.6-sol", "openai/gpt-6-astra"],
      "deep_reasoning": ["openai/gpt-6-astra", "alibaba/qwen3.8-max"],
      "multimodal": ["moonshotai/kimi-k3", "anthropic/claude-opus-5", "google/gemini-3.8-flash"],
      "long_context_cheap": ["openai/gpt-5.6-luna", "zai/glm-5.3"]
    },
    "escalation_triggers": [
      "tool_call_malformed twice in a row",
      "self-reported low confidence",
      "output failed schema validation",
      "loop exceeded step budget without progress",
      "explicit user correction"
    ],
    "fallback_chains": {
      "note": "Pass as providerOptions.gateway.models array. Order matters.",
      "frontier": ["anthropic/claude-fable-5.1", "anthropic/claude-opus-5", "anthropic/claude-opus-4.8"],
      "workhorse": ["anthropic/claude-sonnet-5", "google/gemini-3.8-flash", "zai/glm-5.3"],
      "budget": ["deepseek/deepseek-v4.1-flash", "zai/glm-5.3-flash", "google/gemini-2.5-flash-lite"]
    }
  },

  "cost_model": {
    "formula": "cost = (uncached_in/1e6 * price.input) + (cached_in/1e6 * price.cache_read) + (out/1e6 * price.output) + (searches/1000 * web_search_per_1k)",
    "guidance": [
      "In agent loops the system prompt + tool schemas repeat every step. Measure cache_read, not input.",
      "Reasoning tokens bill as output. A 'cheap input' model with verbose thinking can cost more than a pricier terse one.",
      "'-fast' variants are the same weights at 2x price; they buy priority capacity only.",
      "Grok models re-price the ENTIRE request at 2x once the prompt crosses 200K tokens."
    ]
  },

  "selection_score": {
    "description": "Reference scoring function. Tune weights per workload.",
    "formula": "score = w_q * (bench.overall / 100) + w_c * (1 - normalised_cost) + w_l * (1 - normalised_latency) + w_r * (min(provider_count, 5) / 5)",
    "presets": {
      "quality_first": { "w_q": 0.70, "w_c": 0.10, "w_l": 0.10, "w_r": 0.10 },
      "balanced":      { "w_q": 0.40, "w_c": 0.30, "w_l": 0.20, "w_r": 0.10 },
      "cost_first":    { "w_q": 0.20, "w_c": 0.55, "w_l": 0.15, "w_r": 0.10 },
      "latency_first": { "w_q": 0.25, "w_c": 0.15, "w_l": 0.50, "w_r": 0.10 }
    },
    "category_override": "For task-specific routing, substitute bench.agentic / bench.coding / bench.reasoning for bench.overall."
  }
}
