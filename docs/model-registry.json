    "source": "Vercel AI Gateway catalog + BenchAlign v5.2 leaderboard",
    "snapshot_date": "2026-09-16",
    "price_unit": "USD per 1M tokens",
    "notes": [
      "Gateway charges provider list price with no markup, incl. BYOK.",
      "Prices marked promo_until are temporary; re-verify before relying on them.",
      "bench.* scores are 0-100 composite/category scores. null = not measured.",
      "latency_s is P50 time-to-first-token from live gateway traffic; volatile.",
      "web_search_per_1k is billed on top of tokens when the tool is used."
    ],
    "revalidate_every_days": 14
  },

